{
  "name": "sns-ai",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Multi-account autonomous social publishing, analytics, experiments, learning and operations engine for X and Instagram via GitHub Actions.",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "SNS_MANUAL_INVOCATION=true node --test --test-concurrency=1",
    "coverage": "SNS_MANUAL_INVOCATION=true node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='src/**/*.mjs' --test-coverage-lines=90 --test-coverage-branches=60 --test-coverage-functions=82",
    "check": "node src/ops/check-all.mjs",
    "validate": "node src/validate-strict-config.mjs",
    "autopilot": "node src/orchestrate.mjs",
    "engagement": "node src/engagement/run.mjs",
    "engagement-scheduled": "node src/engagement/scheduled.mjs",
    "engagement-activate": "node src/engagement/activate.mjs",
    "account-control": "node src/ops/account-control.mjs",
    "metrics": "node src/analytics/collector.mjs",
    "learn": "node src/learning/learn.mjs",
    "trends": "node src/research/trends.mjs",
    "policy-watch": "node src/research/policy-watch.mjs",
    "report": "node src/reports/generate.mjs",
    "weekly-report": "node src/reports/weekly.mjs",
    "doctor": "node src/ops/doctor-strict.mjs",
    "smoke": "node src/ops/smoke.mjs",
    "preflight": "node src/ops/live-preflight.mjs",
    "feedback": "node src/feedback/record.mjs",
    "affiliate-readiness": "node src/monetization/affiliate-readiness.mjs",
    "hub:stage": "node src/hub/stage.mjs",
    "hub:reconcile": "node src/hub/reconcile.mjs",
    "secret-scan": "node src/ops/secret-scan.mjs",
    "manual-only-audit": "node src/ops/manual-only-audit.mjs",
    "maintenance": "node src/ops/maintenance.mjs",
    "expire-approvals": "node src/ops/stale-approvals.mjs",
    "stale-claims": "node src/ops/stale-claims.mjs"
  }
}
